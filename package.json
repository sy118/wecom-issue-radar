{
  "name": "wecom-issue-radar",
  "private": true,
  "version": "4.2.3",
  "description": "从本机企业微信群聊提炼业务问题并导出报表的 Windows 桌面工具",
  "author": "sy118",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/build-electron.mjs && electron .",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "package": "pnpm build && electron-builder --win nsis --publish never",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.13.1"
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "企微问题雷达",
  "version": "3.2.10",
  "identifier": "com.sy118.wecom-issue-radar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "企微问题雷达",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/wecom-issue-radar-worker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "shortDescription": "从企业微信群聊提炼每日业务问题并导出报表",
    "longDescription": "读取本机企业微信群聊，支持 OCR、大模型分析、Excel/Markdown 导出和腾讯文档 Smart Sheet 同步。"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFQjc5NTRFRjhFNEJFMTcKUldRWHZ1VDRUcFczbmpTSnFySVY0OE9vc2FLNWNNOWdpbWJVZ2FpK1VYeS9wY2t4SjRzelN0OXAK",
      "endpoints": [
        "https://github.com/sy118/wecom-issue-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
